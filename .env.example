# ===========================================
# 极粹工具 (Essence Tools) 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ===========================================

# ---------- JWT 认证 ----------
# JWT 签名密钥（生产环境必须设置为强随机值）
# 生成方式: openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---------- 数据库 ----------
# SQLite（开发环境默认）
DATABASE_URL="file:./dev.db"
# PostgreSQL（生产环境推荐，使用时取消下行注释并注释上行）
# DATABASE_URL="postgresql://user:password@localhost:5432/essence_tools?sslmode=require"
# 注意：切换到 PostgreSQL 时还需修改 prisma/schema.prisma 中的 provider，
# 详见 schema.prisma 底部的 [生产部署指南]

# ---------- 应用配置 ----------
# 运行环境: development | production
NODE_ENV=development
# 应用端口（默认 3000）
PORT=3000
