# ===========================================
# ToolBox 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ===========================================

# ---------- JWT 认证 ----------
# JWT 签名密钥（生产环境必须设置）
# 生成方式: openssl rand -base64 32 或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---------- 数据库 ----------
# SQLite（默认）
DATABASE_URL="file:./dev.db"
# PostgreSQL（可选，如需切换）
# DATABASE_URL="postgresql://user:password@localhost:5432/toolbox"

# ---------- 应用配置 ----------
# 运行环境: development | production
NODE_ENV=development
# 应用端口（默认 3000）
PORT=3000
